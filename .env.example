# Copie para .env e preencha (não commitar .env)
OPENAI_API_KEY=sk-...

# Preparação automática — livro lfb (estudo bíblico de congregação)
OPENAI_LFB_PREP_MODEL=gpt-4.1

# Preparação automática da apostila (meio de semana)
OPENAI_MWB_PREP_MODEL=gpt-4.1

# Preparação completa de tribuna — Tesouros + Vida Cristã (Elder)
OPENAI_DISCOURSE_PREP_MODEL=gpt-4.1

# Preparação automática — estudo de A Sentinela (matéria inteira)
OPENAI_WATCHTOWER_PREP_MODEL=gpt-4.1

# Outros (ex.: livro lfb) — padrão gpt-4o
# OPENAI_AUTO_PREP_MODEL=gpt-4o

# PIN da área Elder — só na sua máquina de build; vira hash no instalador (nunca texto plano no .exe)
JCS_ELDER_PIN=