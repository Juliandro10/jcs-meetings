<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jcs_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jcs_surface"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:id="@+id/readTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/jcs_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/togglePanelButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="4dp"
            android:background="@android:color/transparent"
            android:text="@string/panel_hide"
            android:textAllCaps="false"
            android:textColor="@color/jcs_purple_bright"
            android:textSize="13sp" />

        <Button
            android:id="@+id/layoutModeButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="4dp"
            android:background="@android:color/transparent"
            android:text="@string/layout_switch_landscape"
            android:textAllCaps="false"
            android:textColor="@color/jcs_purple_bright"
            android:textSize="13sp" />

        <Button
            android:id="@+id/textSmallerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="A−"
            android:textAllCaps="false"
            android:textColor="@color/jcs_purple_bright"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="48dp"
            android:textColor="@color/jcs_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/textLargerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="A+"
            android:textAllCaps="false"
            android:textColor="@color/jcs_purple_bright"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/splitContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/outlinePane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7">

            <com.jcs.read2.NoZoomWebView
                android:id="@+id/outlineWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/outlineProgress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <View
            android:id="@+id/splitDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3a3a44" />

        <LinearLayout
            android:id="@+id/sidePane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#16161c"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <Button
                    android:id="@+id/tabVerseButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/tab_verse"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/tabNotesButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="@string/tab_notes"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/verseStack"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/biblePanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/bible_panel_title"
                        android:textColor="@color/jcs_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/bibleReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/jcs_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.jcs.read2.NoZoomWebView
                        android:id="@+id/bibleWebView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/bibleProgress"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/bibleEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/bible_empty"
                    android:textColor="@color/jcs_muted"
                    android:textSize="13sp" />
            </FrameLayout>

            <com.jcs.read2.NoZoomWebView
                android:id="@+id/notesWebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
