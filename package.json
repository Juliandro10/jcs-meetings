{
  "name": "jcs-meetings",
  "productName": "JCS Meetings",
  "version": "0.1.0",
  "private": true,
  "description": "Preparação de reuniões com paridade JW Library + IA",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
