<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginRight="14dp">

        <View
            android:id="@+id/docThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/thumb_placeholder_default" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/docSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jcs_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/docTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jcs_accent_blue"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/docDeleteButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="4dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/delete_document"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_delete"
        android:visibility="gone" />
</LinearLayout>
