<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback XML sem vector — compativel com Android 4.4 quando PNG nao e usado. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#4C1D95"
                android:startColor="#8B5CF6"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="18dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <layer-list>
            <item android:right="26dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
            <item android:left="26dp">
                <shape android:shape="rectangle">
                    <solid android:color="#EDE9FE" />
                </shape>
            </item>
            <item
                android:left="24dp"
                android:right="24dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
